<Project Sdk="Microsoft.NET.Sdk">
  <!-- PlayOut's Xbox / Xbox 360 image helper (see README.md). Built by scripts/build-xbox-helper.mjs into
       resources/xbox/PlayOutXbox.exe: one self-contained, trimmed win-x64 file, so users need no .NET install. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PlayOutXbox</AssemblyName>
    <RootNamespace>PlayOutXbox</RootNamespace>
    <Version>1.3.0</Version>
    <Product>PlayOut Xbox helper</Product>
    <Description>Xbox / Xbox 360 disc image conversions for PlayOut (XISOSharp, CHDSharp).</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- XISOSharp 2.0.1 lists Microsoft.NET.ILLink.Tasks 11 (the trimmer) as a dependency; a build-time tool, not
         code that ships. Publishing with the .NET 10 SDK keeps its own trimmer (10.0.x) - the "downgrade" is that. -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT; pulls in CCISharp, ZArchiveSharp, StfsSharp (MIT, same author). -->
    <PackageReference Include="XISOSharp" Version="2.0.1" />
    <!-- MIT; vendors zlib (zlib), LZMA (public domain), Zstandard (MIT/BSD) and FLAC (LGPL-2.1, see below) ports. -->
    <PackageReference Include="CHDSharp" Version="1.7.0" />
  </ItemGroup>

  <!-- VendoredFlac (CHDSharp's FLAC codec) is LGPL-2.1: it ships as its own, unmodified VendoredFlac.dll next to
       the exe (not bundled, not trimmed), so it can be replaced with a rebuilt copy as the LGPL requires. Keeping it
       whole also covers the only trim warning (IL2026: its settings' [DefaultValue]s are applied through
       TypeDescriptor reflection). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="VendoredFlac" />
  </ItemGroup>
  <Target Name="KeepVendoredFlacUnmodified" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'VendoredFlac'">
        <IsTrimmable>false</IsTrimmable>
        <TrimMode>copy</TrimMode>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>
  <Target Name="ShipVendoredFlacSeparately" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'VendoredFlac'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
