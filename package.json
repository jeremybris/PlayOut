{
  "name": "playout",
  "version": "0.9.100",
  "description": "PlayOut - console-style game launcher for Windows (stores, ROMs, emulators)",
  "main": "./out/main/index.js",
  "author": "Jeremy Bristol",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && node scripts/sync-coop-helper.mjs && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --publish always",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "i18n:check": "node scripts/i18n-check.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "bench:art": "node scripts/bench-art.mjs",
    "scan-art-bench": "electron-vite build && electron . --user-data-dir=%TEMP%\\playout-art-bench --art-bench",
    "make-icon": "electron scripts/make-icon.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@node-steam/vdf": "^2.2.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.11.2",
    "protobufjs": "^8.8.1",
    "selfsigned": "^2.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.36.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
