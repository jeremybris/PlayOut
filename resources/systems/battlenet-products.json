{
  "_source": {
    "description": "Battle.net product table for PlayOut. code/uid/name/type/classicExecutable/apiId/media/links are transcribed from Playnite's BattleNetLibrary (BattleNetGames.cs) via docs/research/battlenet-products.json; installFolder/executables/processNames were added for PlayOut from the default Battle.net install layout and are not part of Playnite.",
    "license": "MIT, Copyright (c) 2020 Josef Nemec (LICENSE.md of both repos). Keep this notice when reusing the table.",
    "upstream": "https://codeberg.org/CrowIsTaken/PlayniteExtensions (branch main10, commit f008798eb06c6eb1e9cc48711a5a56d470c2cf2d, 2026-10-18); byte-identical to the archived GitHub copy https://github.com/JosefNemec/PlayniteExtensions (master, commit 886468f65724e6fd104f3a09847a17ba57cfb430) for every BattleNetLibrary .cs file",
    "detection": "Registry: Uninstall entries whose UninstallString matches Battle\\.net.*--uid=(.*?)\\s (uid prefix-matched against `uid`; DisplayName ending in Test/Beta skipped). Fallback: %ProgramData%\\Battle.net\\Agent\\product.db (protobuf, uid match). Classic: Publisher \"Blizzard Entertainment\" + DisplayName equal to `uid` + classicExecutable present.",
    "launch": "\"<client>\\Battle.net.exe\" --exec=\"launch <code>\" (classic products: run <installDir>\\<classicExecutable>). Install: --game=<uid>."
  },
  "_fields": {
    "code": "Battle.net product code: the argument of --exec=\"launch <code>\" and the PlayOut externalId.",
    "uid": "Battle.net uid prefix as found in the Uninstall string (--uid=wow_enus) and in product.db; for classic products the Uninstall DisplayName.",
    "type": "default = launched through the Battle.net client; classic = legacy installer launched by classicExecutable.",
    "installFolder": "Default folder name under Program Files (x86); informational, the install directory always comes from the registry or product.db.",
    "executables": "Game executables relative to the install directory (the first existing one becomes exePath). Empty = unknown.",
    "processNames": "Process names (without .exe) used for session tracking; empty = unknown, the provider then tracks by install directory."
  },
