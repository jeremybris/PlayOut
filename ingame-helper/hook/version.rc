// Version resource of PlayOutOverlay64.dll.
#include <winver.h>
#include "playout_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLAYOUT_INGAME_VERSION_MAJOR, PLAYOUT_INGAME_VERSION_MINOR, PLAYOUT_INGAME_VERSION_PATCH, 0
 PRODUCTVERSION PLAYOUT_INGAME_VERSION_MAJOR, PLAYOUT_INGAME_VERSION_MINOR, PLAYOUT_INGAME_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PlayOut"
      VALUE "ProductName", "PlayOut in-game overlay"
      VALUE "FileDescription", "PlayOut in-game overlay"
      VALUE "FileVersion", PLAYOUT_INGAME_VERSION
      VALUE "ProductVersion", PLAYOUT_INGAME_VERSION
      VALUE "OriginalFilename", "PlayOutOverlay64.dll"
      VALUE "InternalName", "PlayOutOverlay64.dll"
      VALUE "LegalCopyright", "Copyright (c) 2026 Jeremy Bristol. MIT licence."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
